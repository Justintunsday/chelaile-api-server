# HTTP server
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=*

# Auth (optional): when set, /v1/* requires X-API-Key / Bearer / ?key=
# API_KEY=change-me

# Per-IP requests per minute; 0 disables the limiter
RATE_LIMIT_PER_MINUTE=0

# Static city dataset
DATA_DIR=./data
# DATA_BASE_URL=https://cdn.jsdelivr.net/gh/<user>/<repo>@main/data
CITIES_CACHE_TTL_MS=21600000

# Access log
LOG_REQUESTS=true
