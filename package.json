{
  "name": "chelaile-api-server",
  "version": "2.0.0",
  "description": "HTTP API + MCP server for Chelaile (车来了) realtime bus, metro and transit data",
  "type": "module",
  "main": "dist/api/server.js",
  "bin": {
    "chelaile-api": "dist/api/server.js",
    "chelaile-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/server.js",
    "start:mcp": "node dist/index.js",
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "wrangler dev -c worker/wrangler.toml",
    "deploy:worker": "wrangler deploy -c worker/wrangler.toml",
    "sync-data": "tsx scripts/sync-data.ts",
    "clean": "rm -rf dist",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "bun test tests/unit",
    "test:e2e": "CHELAILE_E2E=1 bun test tests/e2e",
    "test:all": "bun test tests/unit && CHELAILE_E2E=1 bun test tests/e2e",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "release-it": "^20.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.131.2"
  }
}
